+/** Adds an arena tag on the side of whichever Pokemon has the ability, if that side doesn't have it yet. */
+export class PostSummonAddUserSideTagAbAttr extends PostSummonAbAttr {
+  private readonly tagType: ArenaTagType;
+  private readonly turnCount: number;
+
+  constructor(tagType: ArenaTagType, turnCount: number) {
+    super(true);
+    this.tagType = tagType;
+    this.turnCount = turnCount;
+  }
+
+  private getSide(pokemon: Pokemon): ArenaTagSide {
+    return pokemon.isPlayer() ? ArenaTagSide.PLAYER : ArenaTagSide.ENEMY;
+  }
+
+  public override canApply({ pokemon }: AbAttrBaseParams): boolean {
+    return !globalScene.arena.getTagOnSide(this.tagType, this.getSide(pokemon));
+  }
+
+  public override apply({ pokemon, simulated }: AbAttrBaseParams): void {
+    if (!simulated) {
+      globalScene.arena.addTag(this.tagType, this.turnCount, undefined, pokemon.id, this.getSide(pokemon));
+    }
+  }
+}
+
+/** Light Thief: takes every raised stat stage from the opposing side, up to the usual cap of 6. */
+export class PostSummonStealStatStagesAbAttr extends PostSummonAbAttr {
+  public override canApply({ pokemon }: AbAttrBaseParams): boolean {
+    return pokemon.getOpponents().some(opponent => opponent.getStatStages().some(stage => stage > 0));
+  }
+
+  public override apply({ pokemon, simulated }: AbAttrBaseParams): void {
+    if (simulated) {
+      return;
+    }
+    for (const opponent of pokemon.getOpponents()) {
+      for (const stat of BATTLE_STATS) {
+        const stolen = opponent.getStatStage(stat);
+        if (stolen > 0) {
+          opponent.setStatStage(stat, 0);
+          pokemon.setStatStage(stat, Math.min(pokemon.getStatStage(stat) + stolen, 6));
+        }
+      }
+    }
+  }
+}
